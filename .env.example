# ------------------------------------------------------------------
# cse6332_2026 pipeline settings.
# Copy to .env (setup.py install does this automatically) and edit.
# docker compose and setup.py both read this file; the compose file
# holds no literal credentials, ports or image tags.
# ------------------------------------------------------------------

# Timezone used by containers and for Spark date/hour partitioning
TZ=America/Chicago

# ---- Credentials --------------------------------------------------
# `python setup.py install` replaces every "generated-at-install" value with a
# unique random key/password in your .env (this file keeps the placeholders).
# Show them with: python setup.py secrets    Change them: python setup.py secrets --rotate
S3_ACCESS_KEY=generated-at-install
S3_SECRET_KEY=generated-at-install
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generated-at-install
SEAWEED_ADMIN_USER=admin
SEAWEED_ADMIN_PASSWORD=generated-at-install
# Anyone who can reach Grafana may VIEW dashboards without logging in (read-only, standard
# practice); editing and admin always require the login. Set false to require a login to view.
GRAFANA_ANONYMOUS_ACCESS=true

# ---- Kafka --------------------------------------------------------
# KRaft cluster id (any 22-char base64 uuid; keep stable once data exists)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_TOPICS=test-topic,topic-json,topic-parq
KAFKA_PARTITIONS=1
KAFKA_HEAP_OPTS=-Xmx512m -Xms512m
# Kafka clients on OTHER machines connect to KAFKA_LAN_HOST:KAFKA_LAN_PORT.
# Set it to this machine's LAN IP or DNS name (see README "Accessing the stack
# from other machines"); 127.0.0.1 keeps the LAN listener local-only.
KAFKA_LAN_HOST=127.0.0.1

# ---- S3 (SeaweedFS) -----------------------------------------------
S3_BUCKET=spark-output

# ---- Spark resources ----------------------------------------------
# The worker must have at least 2 x SPARK_APP_CORES (one app per sink).
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
# Docker CPU limit for the Spark worker (where executors run); 0 = unlimited
SPARK_WORKER_CPUS=0
SPARK_APP_CORES=1
SPARK_EXECUTOR_MEMORY=512m
SPARK_DRIVER_MEMORY=512m
SPARK_CONSUMER_MEM_LIMIT=1536m
# Micro-batch trigger interval (e.g. 10s); empty = start the next batch immediately
SPARK_TRIGGER_INTERVAL=
# Max Kafka records per micro-batch (rate limit); empty = unlimited
SPARK_MAX_OFFSETS_PER_TRIGGER=

# ---- cAdvisor (on by default; set false to save memory/CPU) -------
CADVISOR_ENABLED=true

# ---- Producers ----------------------------------------------------
# Seconds setup.py waits for producers to exit after signalling them
PRODUCER_STOP_TIMEOUT=15
# Host-side producers use IPv4 explicitly: on Windows "localhost" resolves to ::1
# first, which Docker Desktop does not forward.
KAFKA_BOOTSTRAP_HOST=127.0.0.1:9092

# ---- Host ports ---------------------------------------------------
KAFKA_PORT=9092
KAFKA_LAN_PORT=9094
KAFKA_JMX_PORT=7071
KAFKA_EXPORTER_PORT=9308
S3_PORT=8333
SEAWEED_MASTER_PORT=9333
SEAWEED_FILER_PORT=8888
SEAWEED_METRICS_PORT=9327
SEAWEED_VOLUME_PORT=8089
SEAWEED_ADMIN_PORT=23646
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_JSON_UI_PORT=4041
SPARK_PARQUET_UI_PORT=4042
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8088

# ---- Image tags (all multi-arch: linux/amd64 + linux/arm64) -------
KAFKA_IMAGE=apache/kafka:3.9.2
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.9.0
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.47
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.2.0
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.6
